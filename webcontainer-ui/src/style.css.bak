* {
  box-sizing: border-box;
}

html,
body,
#app {
  width: 100%;
  height: 100%;
  margin: 0;
}

body {
  overflow: hidden;
  background: #090b10;
  color: #e8edf5;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.shell {
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-rows: 62px 116px minmax(0, 1fr);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px;
  border-bottom: 1px solid #202633;
  background: #0d1016;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.logo {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #ffffff;
  color: #090b10;
  font-weight: 900;
}

.brand strong {
  display: block;
  font-size: 13px;
  letter-spacing: 0.08em;
}

.brand span {
  display: block;
  margin-top: 3px;
  color: #7f8999;
  font-size: 11px;
}

.runtime {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #aab3c2;
  font-size: 12px;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #5b6574;
}

.dot.online {
  background: #4ade80;
}

.commandbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 100px;
  gap: 10px;
  padding: 14px 18px;
  border-bottom: 1px solid #202633;
  background: #0b0e14;
}

#prompt {
  width: 100%;
  height: 88px;
  resize: none;
  padding: 13px;
  border: 1px solid #29303d;
  border-radius: 8px;
  outline: none;
  background: #11151d;
  color: #f5f7fa;
}

#prompt:focus {
  border-color: #596579;
}

.primary {
  border: 0;
  border-radius: 8px;
  background: #ffffff;
  color: #090b10;
  font-weight: 800;
}

.primary:disabled {
  cursor: wait;
  opacity: 0.5;
}

.workspace {
  min-height: 0;
  display: grid;
  grid-template-columns: 230px minmax(0, 1fr);
}

.sidebar {
  min-height: 0;
  overflow: auto;
  padding: 14px;
  border-right: 1px solid #202633;
  background: #0d1016;
}

.panelTitle {
  margin-bottom: 10px;
  color: #778195;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

#fileTree {
  margin: 0;
  color: #aeb7c7;
  font: 11px/1.65 ui-monospace, SFMono-Regular, Menlo, monospace;
  white-space: pre-wrap;
  word-break: break-word;
}

.center {
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-rows: 48px minmax(0, 1fr) 190px;
}

.previewHeader,
.terminalHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
  border-bottom: 1px solid #202633;
  background: #10141b;
}

.previewHeader strong,
.terminalHeader strong {
  font-size: 12px;
}

.previewHeader span {
  margin-left: 10px;
  color: #697487;
  font-size: 10px;
}

.actions {
  display: flex;
  gap: 6px;
}

.actions button {
  border: 1px solid #2a3240;
  border-radius: 6px;
  background: #161b24;
  color: #b9c2d0;
  padding: 6px 9px;
  font-size: 11px;
}

.preview {
  position: relative;
  min-height: 0;
  background: #ffffff;
}

#previewFrame {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  background: #ffffff;
}

.empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 7px;
  color: #7b8595;
  background: #0b0e14;
}

.emptyIcon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid #2a3240;
  border-radius: 10px;
  color: #c4ccd8;
}

.empty strong {
  color: #dce2ea;
  font-size: 13px;
}

.empty span {
  font-size: 11px;
}

.terminal {
  min-height: 0;
  display: grid;
  grid-template-rows: 38px minmax(0, 1fr);
  border-top: 1px solid #202633;
  background: #080a0e;
}

.terminalHeader {
  border-bottom: 1px solid #202633;
}

.terminalHeader span {
  color: #778195;
  font-size: 10px;
}

#terminalOutput {
  min-height: 0;
  margin: 0;
  overflow: auto;
  padding: 10px 12px;
  color: #cbd5e1;
  font: 11px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;
  white-space: pre-wrap;
}

@media (max-width: 800px) {
  .shell {
    grid-template-rows: 58px 120px minmax(0, 1fr);
  }

  .sidebar {
    display: none;
  }

  .workspace {
    grid-template-columns: 1fr;
  }

  .commandbar {
    grid-template-columns: 1fr;
  }

  .primary {
    height: 38px;
  }

  .center {
    grid-template-rows: 48px minmax(0, 1fr) 170px;
  }
}
